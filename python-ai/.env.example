# Redis (must match backend/.env.example)
REDIS_URL=redis://localhost:6379
CHANNEL_PDF_REQUEST=pdf_process_requests
CHANNEL_PDF_RESPONSE=pdf_process_responses
CHANNEL_QUESTION_REQUEST=question_requests
CHANNEL_QUESTION_RESPONSE=question_responses

# LLM provider — OpenAI is used by default for generation.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here
OPENAI_CHAT_MODEL=gpt-4o-mini

# Embeddings: set EMBEDDING_PROVIDER=openai to use OpenAI embeddings (paid, more accurate)
# or EMBEDDING_PROVIDER=huggingface to use a free local sentence-transformers model
# (all-MiniLM-L6-v2) so the whole embeddings pipeline can run with zero API cost.
EMBEDDING_PROVIDER=huggingface
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Vector DB (Chroma, persisted to local disk — free, no external service required)
CHROMA_PERSIST_DIR=chroma_db

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Retrieval
TOP_K=4

# FastAPI (health check server, runs alongside the redis listener)
AI_SERVICE_PORT=8000
