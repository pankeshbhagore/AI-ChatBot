# Server
PORT=5000
NODE_ENV=development

# Database (MongoDB)
MONGO_URI=mongodb://localhost:27017/kb_chatbot

# Redis (Pub/Sub bridge to Python AI service)
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change_this_super_secret_value
JWT_EXPIRES_IN=1d

# Admin bootstrap (used by the seed script to create the first admin user)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345

# CORS
FRONTEND_ORIGIN=http://localhost:3000

# Uploads
UPLOAD_DIR=uploads

# Redis channels (must match python-ai/.env.example)
CHANNEL_PDF_REQUEST=pdf_process_requests
CHANNEL_PDF_RESPONSE=pdf_process_responses
CHANNEL_QUESTION_REQUEST=question_requests
CHANNEL_QUESTION_RESPONSE=question_responses

# How long backend waits for python-ai to respond over Redis before timing out (ms)
REDIS_RESPONSE_TIMEOUT_MS=60000

# OpenAI
OPENAI_ORG_ID=org-Xk7TsUZqEZ9TBv4ihXtICkOU
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o
